# Variables lues par docker-compose.yml (copier ce fichier en .env pour les changer).
# Toutes ont une valeur par defaut : sans .env, "docker compose up" fonctionne
# quand meme, pour un usage local uniquement.

# Cle de signature des jetons de connexion : IDENTIQUE pour les 3 APIs
JWT_SECRET=changez_moi_par_une_longue_chaine_aleatoire

# Mots de passe des bases de donnees
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=

# Compte administrateur cree par: docker compose exec backend npm run seed:admin
ADMIN_EMAIL=admin@billetterie.com
ADMIN_PASSWORD=

# Adresse du frontend (lien de confirmation envoye par e-mail)
FRONTEND_URL=http://localhost:5173

# E-mail (optionnel : sans identifiants, aucun e-mail n'est envoye)
EMAIL_USER=
EMAIL_PASS=

# Optionnel : si un antivirus/proxy inspecte le HTTPS (erreur
# UNABLE_TO_VERIFY_LEAF_SIGNATURE pendant "npm ci" dans Docker), mettre ici son
# certificat racine encode en base64. La verification TLS reste active.
EXTRA_CA_B64=

# Optionnel : meme antivirus, pour l'envoi d'e-mails (SMTP) depuis le conteneur.
# Valeur a mettre si EXTRA_CA_B64 est renseigne : /usr/local/share/extra-ca.pem
NODE_EXTRA_CA_CERTS=
