# Dependances (regenerees avec npm install, jamais a versionner)
node_modules/
backend/node_modules/
frontend/node_modules/
service-abonnements/node_modules/
service-billetterie/node_modules/
service-billetterie/logs/
logs/

# Fichiers .env (contiennent les vrais mots de passe/cles, jamais publics)
.env
backend/.env
service-abonnements/.env
service-billetterie/.env
frontend/.env

# Fichiers generes par le build (recrees a chaque compilation)
dist/
build/
.cache/
coverage/
npm-debug.log*

# Config personnelle de l'editeur (propre a chaque developpeur)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Fichiers systeme crees automatiquement par Windows/macOS
.DS_Store
Thumbs.db

# Photos de profil uploadees en local (donnees, pas du code)
backend/uploads/
